{
  "imports": {
    "@oak/oak": "jsr:@oak/oak@^17.2.0",
    "@tajpouria/cors": "jsr:@tajpouria/cors@^1.2.1",
    "@supabase/supabase-js": "npm:@supabase/supabase-js@^2.89.0"
  },
  "tasks": {
    "dev:vite": "deno run -A npm:vite",
    "dev:api": "deno run -A --env-file=../loan-be/.env --watch ./api/main.ts",
    "dev": "deno task dev:vite & deno task dev:api",
    "build": "deno run -A npm:vite build",
    "serve": "deno run -A npm:vite build && deno run -A ./api/main.ts"
  },
  "nodeModulesDir": "auto",
  "compilerOptions": {
      "types": [
          "react",
          "react-dom",
          "@types/react"
      ],
      "lib": [
          "dom",
          "dom.iterable",
          "deno.ns"
      ],
      "jsx": "react-jsx",
      "jsxImportSource": "react"
  }
}
